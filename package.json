{
  "name": "@mnemosyne-plugins/mnemo-labwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab Watch: every day, the new publications of the AI labs (OpenAI, Anthropic, Google DeepMind, Meta, Mistral AI), read from OpenAlex and the OpenAI news feed by the host's background watch.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:cartridge": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mnemosyne_os/cartridge-sdk": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mnemosyne-OS/MnemoLabWatch"
  }
}
